{
  "name": "panfind",
  "private": true,
  "version": "0.3.8",
  "description": "盘搜 — 网盘公开分享元搜索 MVP",
  "scripts": {
    "dev": "concurrently -n api,yunlan -c cyan,magenta \"npm run dev -w api\" \"npm run dev -w yunlan\"",
    "dev:api": "npm run dev -w api",
    "dev:yunlan": "npm run dev -w yunlan",
    "dev:web": "npm run dev -w yunlan",
    "build": "npm run build -w yunlan",
    "start": "npm run start -w api",
    "smoke": "npm run smoke -w api"
  },
  "workspaces": [
    "api",
    "yunlan"
  ],
  "devDependencies": {
    "concurrently": "^9.1.2",
    "puppeteer-core": "^25.16.0"
  }
}
